extends layout

block titulo_seccion
  h2 Gestión de usuarios

block  content

  div
    a(href="/usuarios/nuevo-usuario") Agregar nueva usuario

  h3 Lista de usuarios
  table(border = 1)
    thead
      tr
        th Nombre
        th Apellido
        th Rol
        th Acciones
    tbody
      each usuario in usuariosActivos
        tr
          td= usuario.nombre
          td= usuario.apellido
          td= ROLES[usuario.rol.toUpperCase()] ? ROLES[usuario.rol.toUpperCase()].label : usuario.rol
          td
            a(href=`/usuarios/detalle-usuario/${usuario.id}`) Ver detalle