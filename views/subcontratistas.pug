extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2 Gestión de Subcontratistas

    a.btn.btn-success(href="/subcontratistas/nuevo-subcontratista")
      i.bi.bi-plus-lg.me-2
      | Agregar nuevo subcontratista

block content
  .card.border-primary.shadow-sm.mb-5.overflow-hidden

    .card-header.bg-white.py-3
      h5.mb-0 Lista de Subcontratistas Activos

    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th.px-4 Nombre o Razón Social
              th CUIT
              th Especialidad
              th.text-center Acciones

          tbody
            each subcontratista in subcontratistasActivos
              tr
                td.px-4.fw-bold= subcontratista.nombre
                td= subcontratista.cuit
                td= subcontratista.especialidad
                td.text-center
                  a.btn.btn-sm.btn-outline-primary(href=`/subcontratistas/detalle-subcontratista/${subcontratista.id}`)
                    i.bi.bi-eye.me-1
                    | Ver detalle

            else
              tr
                td(colspan="4").text-center.py-4.text-muted
                  i.bi.bi-info-circle.me-2
                  | No hay subcontratistas activos registrados en el sistema.

  .d-flex.justify-content-end.mt-4.mb-5
    a.btn.btn-outline-secondary.mb-5(href="/")
      i.bi.bi-arrow-left.me-2
      | Volver al inicio