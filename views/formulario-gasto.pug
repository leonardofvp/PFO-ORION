extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2= editable ? "Editar Gasto" : "Registrar Nuevo Gasto"

block content
  .card.border-secondary.shadow-sm.mb-5
    .card-body.p-4

      include ../views/alertas-validacion.pug

      form(method="POST", action= editable ? `/gastos/editar-gasto/${gasto.id}?_method=PUT` : `/gastos/nuevo-gasto`)

        .row.mb-3
          .col-md-6
            label.form-label.fw-bold(for="idObra") Obra
            if !editable
              select#idObra.form-select.border-secondary(name="idObra")
                option(value="", disabled, selected) Seleccione una obra...
                each obra in obras
                  option(value=obra.id) #{obra.nombre}
            else
              input.form-control(type="text", value=gasto.idObra.nombre)
              input(type="hidden", name="idObra", value=gasto.idObra.id)

          .col-md-6
            label.form-label.fw-bold(for="monto") Monto ($)
            input#monto.form-control.border-secondary(type="number", step="0.01", name="monto", value=(gasto.monto || ""))

        .mb-3
          label.form-label.fw-bold(for="descripcion") Descripción
          input#descripcion.form-control.border-secondary(type="text", name="descripcion", value=(gasto.descripcion || ""))

        .row.mb-4
          .col-md-6
            label.form-label.fw-bold(for="estado") Estado
            select#estado.form-select.border-secondary(name="estado")
              option(value="pendiente", selected=(gasto.estado === "pendiente")) Pendiente
              option(value="pagado", selected=(gasto.estado === "pagado")) Pagado
              option(value="rechazado", selected=(gasto.estado === "rechazado")) Rechazado

          .col-md-6
            label.form-label.fw-bold(for="fecha") Fecha
            input#fecha.form-control.border-secondary(type="date", name="fecha", value=(gasto.fecha ? new Date(gasto.fecha).toISOString().split('T')[0] : ""))

        .mb-5

        .d-flex.justify-content-end.gap-2
          if editable
            a.btn.btn-secondary(href=`/gastos/detalle-gasto/${gasto.id}`) Cancelar
          else
            a.btn.btn-secondary(href="/gastos") Volver al listado

          button.btn(type="submit" class= editable ? "btn-warning" : "btn-primary")
            i.bi(class=editable ? "bi-pencil-square me-2" : "bi-check-lg me-2")
            | #{editable ? "Guardar cambios" : "Crear gasto"}