extends layout

block content
    div
        h2 Detalle de usuario
        ul
            li Nombre: #{usuario.nombre}
            li Apellido #{usuario.apellido}
            li Email #{usuario.email}
            li Rol: #{ROLES[usuario.rol.toUpperCase()].label}
            li Estado: #{usuario.estado}
        button(type="button" onclick=`window.location.href='/usuarios/editar-usuario/${usuario.id}'`) Editar
        | &nbsp;|&nbsp;
        form(action=`/usuarios/eliminar-usuario/${usuario.id}?_method=DELETE`, method="POST", style="display:inline")
            button(type="submit") Eliminar

        br
        br

        a(href="/") Volver al inicio
