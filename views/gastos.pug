extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2 Gestión de Gastos

    a.btn.btn-success(href="/gastos/nuevo-gasto")
      i.bi.bi-plus-lg.me-2
      | Agregar nuevo gasto

block content
  .card.border-secondary.shadow-sm.mb-5.overflow-hidden

    .card-header.bg-white.py-3
      h5.mb-0 Lista de Gastos

    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th.px-4 Nombre de obra
              th Detalle
              th Fecha
              th.text-center Acciones

          tbody
            each gasto in gastosActivos
              tr
                td.px-4= gasto.idObra.nombre
                td= gasto.descripcion
                td= new Date(gasto.fecha).toLocaleDateString('es-AR')
                td.text-center
                  a.btn.btn-sm.btn-outline-primary(href=`/gastos/detalle-gasto/${gasto.id}`)
                    i.bi.bi-eye.me-1
                    | Ver detalle

            else
              tr
                td(colspan="4").text-center.py-4.text-muted
                  i.bi.bi-info-circle.me-2
                  | No hay gastos registrados en el sistema.

  .d-flex.justify-content-end.mt-4.mb-5
    a.btn.btn-secondary.mb-5(href="/")
      i.bi.bi-arrow-left.me-2
      | Volver al inicio