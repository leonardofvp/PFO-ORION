extends layout

block content
    div.container.mt-5
        h2 Detalle de: #{obra.nombre}
        ul.list-group
            li.list-group-item Ubicación: #{obra.ubicacion}
            li.list-group-item Presupuesto inicial: USD #{obra.presupuesto}
            li.list-group-item Estado: #{obra.estado}

        div.mt-3
            button.btn.btn-warning(type="button" onclick=`window.location.href='/obras/editar-obra/${obra.id}'`) Editar
            | &nbsp;
            form(action=`/obras/eliminar-obra/${obra.id}?_method=DELETE`, method="POST", style="display:inline")
                button.btn.btn-danger(type="submit") Eliminar

        br
        hr

        h2 Personal asignado
        if obra.personalAsignado && obra.personalAsignado.length > 0
            table(border = 1)
                thead
                    tr
                        th Nombre
                        th Apellido
                        th Email
                        th Rol
                tbody
                    each usuario in obra.personalAsignado
                        tr
                            td= usuario.nombre
                            td= usuario.apellido
                            td= usuario.email
                            td= ROLES[usuario.rol.toUpperCase()].label
        else
            p No hay personal asignado a esta obra actualmente.

        br
        br

        a(href=`/obras/asignar-personal/${obra.id}`) Asignar personal

        br
        br

        a(href="/obras") Volver a la lista de obras