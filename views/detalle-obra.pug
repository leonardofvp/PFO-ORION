extends layout

block content
    div
        h2 Detalle de: #{obra.nombre}
        ul
            li Ubicación: #{obra.ubicacion}
            li Presupuesto inicial: USD #{obra.presupuesto}
            li Estado: #{obra.estado}

        div
            button(type="button" onclick=`window.location.href='/obras/editar-obra/${obra.id}'`) Editar
            | &nbsp;
            form(action=`/obras/eliminar-obra/${obra.id}?_method=DELETE`, method="POST", style="display:inline")
                button(type="submit") Eliminar

        br
        hr

        h2 Personal asignado

        a(href=`/obras/asignar-personal/${obra.id}`) Asignar personal

        br
        br

        if obra.personalAsignado && obra.personalAsignado.length > 0
            table(border = 1)
                thead
                    tr
                        th Nombre
                        th Apellido
                        th Email
                        th Rol
                tbody
                    each usuario in obra.personalAsignado
                        tr
                            td= usuario.nombre
                            td= usuario.apellido
                            td= usuario.email
                            td= ROLES[usuario.rol.toUpperCase()].label
        else
            p No hay personal asignado a esta obra actualmente.

        br
        hr

        h2 Subcontratistas asignados

        a(href=`/obras/asignar-subcontratista/${obra.id}`) Asignar subcontratista

        br
        br

        if obra.subcontratistasAsignados && obra.subcontratistasAsignados.length > 0
            table(border = 1)
                thead
                    tr
                        th Nombre o Razón Social
                        th CUIT
                        th Especialidad
                        th Teléfono
                        th Email
                tbody
                    each subcontratista in obra.subcontratistasAsignados
                        tr
                            td= subcontratista.nombre
                            td= subcontratista.cuit
                            td= subcontratista.especialidad
                            td= subcontratista.telefono
                            td= subcontratista.email
        else
            p No hay subcontratistas asignados a esta obra actualmente.

        br
        br

        a(href="/obras") Volver a la lista de obras