extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2 Detalle de Obra: #{obra.nombre}

    div
      a.btn.btn-warning.me-2(href=`/obras/editar-obra/${obra.id}`)
        i.bi.bi-pencil-square.me-1
        | Editar
      form(action=`/obras/eliminar-obra/${obra.id}?_method=DELETE`, method="POST" style="display:inline")
        button.btn.btn-danger(type="submit")
          i.bi.bi-trash.me-1
          | Eliminar

block content

  .card.shadow-sm.mb-5.border-primary
    .card-body
      .row.text-center
        .col-md-4.mb-3.mb-md-0
          span.text-muted.d-block.fw-bold Ubicación
          span.fs-5 #{obra.ubicacion}
        .col-md-4.mb-3.mb-md-0
          span.text-muted.d-block.fw-bold Presupuesto Inicial
          span.fs-5 USD #{obra.presupuesto}
        .col-md-4
          span.text-muted.d-block.fw-bold Estado
          span.badge.bg-primary.fs-6.mt-1 #{obra.estado}

  //- SECCIÓN: Personal Asignado
  .d-flex.justify-content-between.align-items-end.mb-3
    h3.mb-0 Personal asignado
    a.btn.btn-sm.btn-success(href=`/obras/asignar-personal/${obra.id}`)
      i.bi.bi-person-plus.me-1
      | Asignar personal

  if obra.personalAsignado && obra.personalAsignado.length > 0
    .table-responsive.mb-5
      table.table.table-hover.table-bordered.align-middle
        thead.table-light
          tr
            th Nombre
            th Apellido
            th Email
            th Rol
        tbody
          each usuario in obra.personalAsignado
            tr
              td= usuario.nombre
              td= usuario.apellido
              td= usuario.email
              td
                span.badge.bg-secondary= ROLES[usuario.rol.toUpperCase()].label
  else
    .alert.alert-light.border.text-muted.text-center.mb-5
      i.bi.bi-info-circle.me-2
      | No hay personal asignado a esta obra actualmente.

  //- SECCIÓN: Subcontratistas Asignados
  .d-flex.justify-content-between.align-items-end.mb-3
    h3.mb-0 Subcontratistas asignados
    a.btn.btn-sm.btn-success(href=`/obras/asignar-subcontratista/${obra.id}`)
      i.bi.bi-plus-circle.me-1
      | Asignar subcontratista

  if obra.subcontratistasAsignados && obra.subcontratistasAsignados.length > 0
    .table-responsive.mb-5
      table.table.table-hover.table-bordered.align-middle
        thead.table-light
          tr
            th Nombre o Razón Social
            th CUIT
            th Especialidad
            th Teléfono
            th Email
        tbody
          each subcontratista in obra.subcontratistasAsignados
            tr
              td.fw-bold= subcontratista.nombre
              td= subcontratista.cuit
              td= subcontratista.especialidad
              td= subcontratista.telefono
              td= subcontratista.email
  else
    .alert.alert-light.border.text-muted.text-center.mb-5
      i.bi.bi-info-circle.me-2
      | No hay subcontratistas asignados a esta obra actualmente.

  .d-flex.justify-content-end.mt-4.mb-5
    a.btn.btn-outline-secondary.mb-5(href="/obras")
      i.bi.bi-arrow-left.me-2
      | Volver a la lista de obras