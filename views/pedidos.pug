extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2 Gestión de Pedidos

    a.btn.btn-success(href="/pedidos/nuevo-pedido")
      i.bi.bi-plus-lg.me-2
      | Agregar nuevo pedido

block content
  .card.border-primary.shadow-sm.mb-5.overflow-hidden

    .card-header.bg-white.py-3
      h5.mb-0 Lista de Pedidos

    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th.px-4 Nombre de obra
              th Fecha
              th Tipo
              th Descripción
              th Cantidad
              th Estado
              th.text-center Acciones

          tbody
            each pedido in pedidosActivos
              tr
                td.px-4.fw-bold= pedido.idObra ? pedido.idObra.nombre : 'Obra no encontrada'
                td= new Date(pedido.fecha).toLocaleDateString('es-AR')
                td= pedido.tipo
                td= pedido.descripcion
                td= `${pedido.cantidad} ${pedido.unidad}`
                td
                  span.badge.bg-secondary= pedido.estado
                td.text-center
                  a.btn.btn-sm.btn-outline-primary(href=`/pedidos/detalle-pedido/${pedido.id}`)
                    i.bi.bi-eye.me-1
                    | Ver detalle

            else
              tr
                td(colspan="7").text-center.py-4.text-muted
                  i.bi.bi-info-circle.me-2
                  | No hay pedidos registrados en el sistema.

  .d-flex.justify-content-end.mt-4.mb-5
    a.btn.btn-outline-secondary.mb-5(href="/")
      i.bi.bi-arrow-left.me-2
      | Volver al inicio