doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Cimientos Sólidos S.A
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")

  body

    nav.navbar.navbar-dark.bg-dark.mb-4
      div.container
        a.navbar-brand(href="/") Cimientos Sólidos S.A.

        button.navbar-toggler(type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon

        div#offcanvasNavbar.offcanvas.offcanvas-end.text-bg-dark(tabindex="-1" aria-labelledby="offcanvasNavbarLabel")

          div.offcanvas-header
            h5#offcanvasNavbarLabel.offcanvas-title Menú
            button.btn-close.btn-close-white(type="button" data-bs-dismiss="offcanvas" aria-label="Close")

          div.offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item: a.nav-link(href="/") Inicio
              li.nav-item: a.nav-link(href="/obras") Obras
              li.nav-item: a.nav-link(href="/usuarios") Usuarios
              li.nav-item: a.nav-link(href="/subcontratistas") Subcontratistas
              li.nav-item: a.nav-link(href="/certificaciones-avance") Certificaciones
              li.nav-item: a.nav-link(href="/gastos") Gastos
              li.nav-item: a.nav-link(href="/pedidos") Pedidos
              li.nav-item: a.nav-link(href="/chat-institucional") Chat

              if usuarioLogueado
                hr.text-white-50
                li
                  a.nav-item: a.nav-link(href=`/usuarios/detalle-usuario/${usuario.id}`) Ver Perfil
                li
                  form.m-0.p-0(action="/login/logout" method="POST")
                    button.dropdown-item.text-danger(type="submit") Cerrar sesión

    main.container
      block titulo_seccion

      block alertas
        if error
          div.alert.alert-danger(role="alert")= error

      block content

    footer.container.mt-5.text-center.text-muted
      hr
      p Proyecto Cimientos Sólidos S.A. - Grupo Orión -

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")