extends layout

block titulo_seccion
  h2 Detalle del subcontratista

block content
  div
    ul
      li Nombre o Razón Social: #{subcontratista.nombre}
      li CUIT: #{subcontratista.cuit}
      li Especialidad: #{subcontratista.especialidad}
      li Teléfono: #{subcontratista.telefono || 'No registrado'}
      li Email: #{subcontratista.email || 'No registrado'}
      li Estado: #{subcontratista.estado}

    br

    button(type="button" onclick=`window.location.href='/subcontratistas/editar-subcontratista/${subcontratista.id}'`) Editar
    | &nbsp;|&nbsp;
    form(action=`/subcontratistas/eliminar-subcontratista/${subcontratista.id}?_method=DELETE`, method="POST" style="display:inline")
      button(type="submit") Eliminar

    br
    br

    a(href="/subcontratistas") Volver atrás