extends layout

block titulo_seccion
  .row.justify-content-center
    .col-12.col-lg-8
      h2.mt-4.mb-4= editable ? "Editar Obra: " + obra.nombre : "Registrar Nueva Obra"

block content
  .row.justify-content-center
    .col-12.col-lg-8
      .card.shadow-sm.mb-5.border-secondary
        .card-body.p-4

          include ../views/alertas-validacion.pug

          form(method="POST", action= editable ? `/obras/editar-obra/${obra.id}?_method=PUT` : `/obras/nueva-obra`)

            .mb-3
              label.form-label.fw-bold(for="nombre") Nombre de la obra
              input#nombre.form-control.border-secondary(type="text", name="nombre", value= obra.nombre || "")

            .mb-3
              label.form-label.fw-bold(for="ubicacion") Ubicación
              input#ubicacion.form-control.border-secondary(type="text", name="ubicacion", value= obra.ubicacion || "")

            .row
              .col-md-6.mb-3
                label.form-label.fw-bold(for="presupuesto") Presupuesto inicial
                .input-group
                  span.input-group-text.border-secondary USD
                  input#presupuesto.form-control.border-secondary(type="number", name="presupuesto", value= obra.presupuesto || "")

              .col-md-6.mb-3
                label.form-label.fw-bold(for="estado") Estado
                select#estado.form-select.border-secondary(name="estado")
                  option(value="iniciando" selected= !obra.estado || obra.estado === "iniciando") Iniciando
                  option(value="activa" selected= obra.estado === "activa") Activa
                  option(value="finalizada" selected= obra.estado === "finalizada") Finalizada

            .my-5

            .d-flex.justify-content-end.gap-2
              if editable
                a.btn.btn-outline-secondary(href=`/obras/detalle-obra/${obra.id}`) Cancelar
              else
                a.btn.btn-outline-secondary(href="/obras") Cancelar

              button.btn(type="submit" class= editable ? "btn-warning" : "btn-primary")
                i.bi(class= editable ? "bi-pencil-square me-2" : "bi-check-lg me-2")
                | #{editable ? "Guardar cambios" : "Crear obra"}