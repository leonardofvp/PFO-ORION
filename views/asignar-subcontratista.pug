extends layout

block titulo_seccion
  .d-flex.justify-content-between.align-items-center.mt-4.mb-4
    h2 Asignar subcontratista a: #{obra.nombre}

block content
  .card.shadow-sm.mb-5.border-secondary.overflow-hidden
    .card-header.bg-white.py-3
      h5.mb-0 Lista de subcontratistas disponibles

    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.table-light
            tr
              th.px-4 Nombre o Razón Social
              th CUIT
              th Especialidad
              th.text-center Acciones

          tbody
            each subcontratista in subcontratistasActivos
              tr
                td.px-4.fw-bold= subcontratista.nombre
                td= subcontratista.cuit
                td
                  span.badge.bg-info.text-dark= subcontratista.especialidad
                td.text-center
                  form(action=`/obras/asignar-subcontratista/${obra.id}`, method="POST" style="display:inline")
                    input(type="hidden" name="idSubcontratista", value=subcontratista.id)
                    button.btn.btn-sm.btn-outline-success(type="submit")
                      i.bi.bi-plus-circle.me-1
                      | Asignar a la obra
            else
              tr
                td(colspan="4").text-center.py-4.text-muted
                  i.bi.bi-info-circle.me-2
                  | No hay subcontratistas activos disponibles para asignar en este momento.

  .d-flex.justify-content-end.mt-4.mb-5
    a.btn.btn-outline-secondary.mb-5(href="/")
      i.bi.bi-arrow-left.me-2
      | Volver al inicio