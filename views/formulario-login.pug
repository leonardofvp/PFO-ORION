extends layout

block alertas

block content
  form.mx-auto.p-4.border.rounded.shadow-sm.bg-light.mt-5(action="/login" method="POST" style="max-width: 400px;")

    h3.text-center.mb-4 Iniciar Sesión

    if error
      div.alert.alert-danger.p-2.text-center(role="alert")= error

    label.form-label.fw-bold Email
    div.input-group.mb-3
      input.form-control(type="email" name="email", required)

    label.form-label.fw-bold Password
    div.input-group.mb-4
      input#password.form-control(type="password" name="password", required)
      button#togglePassword.btn.btn-outline-secondary(type="button")
        i.bi.bi-eye

    button.btn.btn-primary.w-100(type="submit") Iniciar sesión

    br
    br

    a.d-block.text-center.text-decoration-none(href="/usuarios/nuevo-usuario") Registrarse

  script.
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');

    togglePassword.addEventListener('click', function () {
      const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
      password.setAttribute('type', type);
      this.querySelector('i').classList.toggle('bi-eye');
      this.querySelector('i').classList.toggle('bi-eye-slash');
    });