extends layout

block content

    h2 Login

    form(action="/login", method="POST")

        label Email
        input(type="email", name="loginEmail", required)

        br
        br

        label Pssword
        input(type="password", name="loginPassword", required)

        br
        br

        button(type="submit") Iniciar sesión

        button#btnAdmin(type="button" style="margin-left: 10px;") Cargar Admin

        script.
            document.getElementById('btnAdmin').addEventListener("click", () => {
                const inputUser = document.querySelector('input[name="loginEmail"]');
                const inputPass = document.querySelector('input[name="loginPassword"]');

                if (inputUser && inputPass) {
                    inputUser.value = "admin@admin.com";
                    inputPass.value = "admin";
                }
            });